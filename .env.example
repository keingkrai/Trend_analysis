# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์จริง (.env ไม่ถูก commit) - คำอธิบายแต่ละตัวอยู่ใน README หัวข้อ "คีย์ API"

# --- LLM: AWS Bedrock (จำเป็น) - ใช้ Bearer token ตัวเดียว หรือคู่ access key ก็ได้ ---
AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Google Trends ⑦ ⑩ (จำเป็น) ---
# ใส่คีย์เดียว หรือหลายคีย์ก็ได้ (ใช้ตามลำดับ คีย์ไหนโควตาหมดสลับไปตัวถัดไปเอง) รูปแบบหลายคีย์:
# SERPAPI_KEY=[
# "คีย์ที่ 1",
# "คีย์ที่ 2"
# ]
SERPAPI_KEY=

# --- Embedding สินค้า ⑫ ⑬ (จำเป็น - ใส่คีย์จริงก่อนรันไปป์ไลน์) ---
# โค้ดสร้าง client ตอน import จึงต้องมีค่าที่ไม่ว่างเสมอ - ค่า placeholder ด้านล่างพอให้รันเทสต์ (pytest) ได้โดยไม่มีคีย์จริง
NVIDIA_API=placeholder

# --- ไม่ได้เรียกใช้จริงแล้ว แต่โค้ดสร้าง client ตอน import จึงต้องมีค่าที่ไม่ว่าง ---
OPENROUTER_API_KEY=placeholder
GEMINI_KEY=placeholder
MODEL_NAME=
MODEL_NAME_META=

# --- สาย Social / ดึงหน้าเว็บ ---
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
APIFY_API_KEY=
TAVILY_API_KEY=

# --- สาย Paper (ไม่มี = ข้ามหรือช้าลง) ---
OPEN_ALEX_KEY=
NCBI_API_KEY=
NCBI_EMAIL=

# --- LLM สำรอง (ไม่บังคับ) ---
TYPHOON_BASE_URL=
TYPHOON_API_KEY=
TYPHOON_MODEL=
